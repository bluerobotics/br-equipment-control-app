{
    "MAIN_STATE": {
        "type": "string",
        "default": "STANDBY",
        "help": "Overall pressurizer system state",
        "gui_var": "pressurizer_main_state_var"
    },
    "pressure_psi": {
        "unit": "msw",
        "type": "float",
        "default": 0.0,
        "precision": 2,
        "multiplier": 0.7032496149,
        "help": "Current pressure reading converted to meters of seawater",
        "gui_var": "pressurizer_pressure_var"
    },
    "enabled": {
        "type": "int",
        "default": 1,
        "map": {
            "0": "Disabled",
            "1": "Enabled"
        },
        "help": "Power enable status for pressurizer motor",
        "gui_var": "pressurizer_enabled_var"
    },
    "cycles_programmed": {
        "type": "int",
        "default": 10,
        "help": "Number of pressure cycles programmed for current test",
        "gui_var": "pressurizer_cycles_programmed_var"
    },
    "cycles_complete": {
        "type": "int",
        "default": 0,
        "help": "Number of pressure cycles completed in current test",
        "gui_var": "pressurizer_cycles_complete_var"
    },
    "tank1_temp_c": {
        "unit": "C",
        "type": "float",
        "default": 25.0,
        "precision": 1,
        "help": "Temperature reading from tank 1 sensor",
        "gui_var": "pressurizer_tank1_temp_var"
    },
    "tank2_temp_c": {
        "unit": "C",
        "type": "float",
        "default": 25.1,
        "precision": 1,
        "help": "Temperature reading from tank 2 sensor",
        "gui_var": "pressurizer_tank2_temp_var"
    }
}