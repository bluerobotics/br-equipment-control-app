{
    "fillhead_state": {
        "type": "int",
        "default": 0,
        "map": {
            "0": "Standby",
            "1": "Busy",
            "2": "Error",
            "3": "Disabled",
            "4": "Clearing Errors"
        },
        "help": "Overall fillhead system state",
        "cpp_source": "static_cast<int32_t>(m_mainState)"
    },
    "injector_state": {
        "type": "int",
        "default": 0,
        "map": {
            "0": "Standby",
            "1": "Homing",
            "2": "Jogging",
            "3": "Feeding",
            "4": "Motor Fault"
        },
        "help": "Current operational state of the injector motors",
        "cpp_source": "static_cast<int32_t>(m_injector.m_state)"
    },
    "inj_valve_state": {
        "type": "int",
        "default": 0,
        "map": {
            "0": "Not Homed",
            "1": "Closed",
            "2": "Open",
            "3": "Halted",
            "4": "Moving",
            "5": "Homing",
            "6": "Jogging",
            "7": "Resetting",
            "8": "Error"
        },
        "help": "Current state of the injection pinch valve",
        "cpp_source": "static_cast<int32_t>(m_injectorValve.m_state)"
    },
    "vac_valve_state": {
        "type": "int",
        "default": 0,
        "map": {
            "0": "Not Homed",
            "1": "Closed",
            "2": "Open",
            "3": "Halted",
            "4": "Moving",
            "5": "Homing",
            "6": "Jogging",
            "7": "Resetting",
            "8": "Error"
        },
        "help": "Current state of the vacuum pinch valve",
        "cpp_source": "static_cast<int32_t>(m_vacuumValve.m_state)"
    },
    "heater_state": {
        "type": "int",
        "default": 0,
        "map": {
            "0": "Off",
            "1": "Active"
        },
        "help": "Heater PID control status",
        "cpp_source": "static_cast<int32_t>(m_heater.m_heaterState)"
    },
    "vacuum_state": {
        "type": "int",
        "default": 0,
        "map": {
            "0": "Off",
            "1": "Pulldown",
            "2": "Settling",
            "3": "Leak Testing",
            "4": "On",
            "5": "Error"
        },
        "help": "Current vacuum system operation state",
        "cpp_source": "static_cast<int32_t>(m_vacuum.m_state)"
    },
    "injector_torque": {
        "unit": "%",
        "type": "float",
        "default": 0.0,
        "precision": 1,
        "help": "Current motor torque percentage for injector",
        "cpp_source": "m_injector.m_smoothedTorqueValue0"
    },
    "injector_homed": {
        "type": "int",
        "default": 0,
        "map": {
            "0": "Not Homed",
            "1": "Homed"
        },
        "help": "Indicates if injector has been homed to machine zero",
        "cpp_source": "m_injector.m_homingMachineDone ? 1 : 0"
    },
    "injection_cumulative_ml": {
        "unit": "ml",
        "type": "float",
        "default": 0.0,
        "precision": 2,
        "help": "Total volume dispensed since last cartridge home",
        "cpp_source": "m_injector.m_cumulative_dispensed_ml"
    },
    "injection_active_ml": {
        "unit": "ml",
        "type": "float",
        "default": 0.0,
        "precision": 2,
        "help": "Volume dispensed in current injection operation",
        "cpp_source": "m_injector.m_active_op_total_dispensed_ml"
    },
    "injection_target_ml": {
        "unit": "ml",
        "type": "float",
        "default": 0.0,
        "precision": 2,
        "help": "Target volume for current injection operation",
        "cpp_source": "m_injector.m_active_op_target_ml"
    },
    "motors_enabled": {
        "type": "bool",
        "default": 1,
        "map": {
            "0": "Disabled",
            "1": "Enabled"
        },
        "help": "Global motor power enable status",
        "cpp_source": "m_injector.m_isEnabled"
    },
    "inj_valve_pos": {
        "unit": "mm",
        "type": "float",
        "default": 0.0,
        "precision": 2,
        "help": "Current position of injection valve actuator",
        "cpp_source": "m_injectorValve.m_motor->PositionRefCommanded() * MOTOR_STEPS_TO_MM"
    },
    "inj_valve_torque": {
        "unit": "%",
        "type": "float",
        "default": 0.0,
        "precision": 1,
        "help": "Current motor torque percentage for injection valve",
        "cpp_source": "m_injectorValve.m_smoothedTorque"
    },
    "inj_valve_homed": {
        "type": "bool",
        "default": 0,
        "map": {
            "0": "Not Homed",
            "1": "Homed"
        },
        "help": "Indicates if injection valve has been homed",
        "cpp_source": "m_injectorValve.m_isHomed"
    },
    "vac_valve_pos": {
        "unit": "mm",
        "type": "float",
        "default": 0.0,
        "precision": 2,
        "help": "Current position of vacuum valve actuator",
        "cpp_source": "m_vacuumValve.m_motor->PositionRefCommanded() * MOTOR_STEPS_TO_MM"
    },
    "vac_valve_motor_torque": {
        "unit": "%",
        "type": "float",
        "default": 0.0,
        "precision": 1,
        "help": "Current motor torque percentage for vacuum valve",
        "cpp_source": "m_vacuumValve.m_smoothedTorque"
    },
    "vac_valve_homed": {
        "type": "bool",
        "default": 0,
        "map": {
            "0": "Not Homed",
            "1": "Homed"
        },
        "help": "Indicates if vacuum valve has been homed",
        "cpp_source": "m_vacuumValve.m_isHomed"
    },
    "temp_c": {
        "unit": "C",
        "type": "float",
        "default": 25.0,
        "precision": 1,
        "help": "Current material temperature from thermocouple",
        "cpp_source": "m_heater.m_smoothedTemperatureCelsius"
    },
    "heater_setpoint": {
        "unit": "C",
        "type": "float",
        "default": 70.0,
        "precision": 1,
        "help": "Target temperature setpoint for PID controller",
        "cpp_source": "m_heater.m_pid_setpoint"
    },
    "vacuum_psig": {
        "unit": "PSIG",
        "type": "float",
        "default": 0.5,
        "precision": 2,
        "help": "Current vacuum pressure reading",
        "cpp_source": "m_vacuum.m_smoothedVacuumPsig"
    }
}