{
    "pressboi.home": {"device": "pressboi", "params": [], "help": "Homes the press."},
    "pressboi.move": {
        "device": "pressboi", 
        "params": [
            {"name": "Pos(mm)", "type": "float", "min": -500, "max": 500, "optional": false},
            {"name": "Speed(mm/s)", "type": "float", "min": 0.1, "max": 100, "optional": true, "default": 10},
            {"name": "Force(kg)", "type": "float", "min": 0, "max": 50000, "optional": true, "default": 10},
            {"name": "ForceLimit", "type": "string", "options": ["continue", "stop", "return"], "optional": true, "default": "return"}
        ], 
        "help": "Moves the press to an absolute position. ForceLimit: 'continue' to ignore force limit, 'stop' to stop if force limit reached, 'return' to retract to start position."
    },
    "pressboi.set_start_pos": {
        "device": "pressboi", 
        "params": [
            {"name": "Pos(mm)", "type": "float", "min": -500, "max": 500, "optional": false}
        ], 
        "help": "Sets the starting position for relative moves."
    },
    "pressboi.move_to_start": {
        "device": "pressboi", 
        "params": [
            {"name": "Pos(mm)", "type": "float", "min": -500, "max": 500, "optional": true, "default": 0},
            {"name": "Speed(mm/s)", "type": "float", "min": 0.1, "max": 100, "optional": true, "default": 10},
            {"name": "Force(kg)", "type": "float", "min": 0, "max": 50000, "optional": true, "default": 10}
        ], 
        "help": "Moves to the defined start position."
    }
}
