{
    "main_state": {
        "type": "string",
        "default": "standby",
        "help": "Overall press system state"
    },
    "force": {
        "unit": "kg",
        "type": "float",
        "default": 0.0,
        "precision": 1,
        "help": "Current force being applied by the press"
    },
    "force_limit": {
        "unit": "kg",
        "type": "float",
        "default": 1000.0,
        "precision": 1,
        "help": "Maximum force limit for current operation"
    },
    "enabled0": {
        "type": "int",
        "default": 1,
        "map": {
            "0": "disabled",
            "1": "enabled"
        },
        "help": "Power enable status for motor 1"
    },
    "enabled1": {
        "type": "int",
        "default": 1,
        "map": {
            "0": "disabled",
            "1": "enabled"
        },
        "help": "Power enable status for motor 2"
    },
    "current_pos": {
        "unit": "mm",
        "type": "float",
        "default": 0.0,
        "precision": 2,
        "help": "Current position of press axis"
    },
    "start_pos": {
        "unit": "mm",
        "type": "float",
        "default": 0.0,
        "precision": 2,
        "help": "Preset starting position for pressing routine"
    },
    "target_pos": {
        "unit": "mm",
        "type": "float",
        "default": 0.0,
        "precision": 2,
        "help": "Target position for current move operation"
    },
    "torque_m1": {
        "unit": "%",
        "type": "float",
        "default": 0.0,
        "precision": 1,
        "help": "Current motor torque percentage for motor 1"
    },
    "torque_m2": {
        "unit": "%",
        "type": "float",
        "default": 0.0,
        "precision": 1,
        "help": "Current motor torque percentage for motor 2"
    },
    "homed": {
        "type": "int",
        "default": 0,
        "map": {
            "0": "not homed",
            "1": "homed"
        },
        "help": "Indicates if press has been homed to zero position"
    }
}
