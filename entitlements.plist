<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow app to receive Apple Events (needed for right-click menus) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    
    <!-- Disable sandbox (allows full menu functionality) -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    
    <!-- Allow outgoing network connections (for your serial/network comms) -->
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- Allow incoming network connections (for network devices) -->
    <key>com.apple.security.network.server</key>
    <true/>
    
    <!-- Allow access to USB devices (for serial communication) -->
    <key>com.apple.security.device.usb</key>
    <true/>
    
    <!-- Allow access to serial ports -->
    <key>com.apple.security.device.serial</key>
    <true/>
</dict>
</plist>

